{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "permissions": [
        { "action": "skill", "resource": "find-skills", "effect": "allow" },
        { "action": "skill", "resource": "writing-for-agents", "effect": "allow" }
      ]
    }
  },
  "permissions": [
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "playwright_*", "resource": "*", "effect": "deny" },
    { "action": "dida365_*", "resource": "*", "effect": "deny" },
    { "action": "homeassistant_*", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "caveman-commit", "effect": "allow" },
    { "action": "skill", "resource": "create-pull-request", "effect": "allow" },
    { "action": "skill", "resource": "karpathy-guidelines", "effect": "allow" }
  ]
}
