{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--viewport-size",
        "1440x900",
        "--timeout-action",
        "10000",
        "--caps",
        "vision,devtools"
      ]
    },
    "dida365": {
      "type": "remote",
      "url": "https://mcp.dida365.com",
      "disabled": false
    },
    "homeassistant": {
      "type": "remote",
      "url": "https://ha.xezzon.xyz/api/mcp",
      "disabled": false,
      "oauth": {
        "client_id": "http://127.0.0.1:19876",
        "callback_port": 19876
      }
    }
  }
}
